            <rdf:Alt>
               <rdf:li xml:lang="x-default">Projektionsobjektiv fÃ¼r die Mikrolithographie</rdf:li>
               <rdf:li xml:lang="de">Projektionsobjektiv fÃ¼r die Mikrolithographie</rdf:li>
